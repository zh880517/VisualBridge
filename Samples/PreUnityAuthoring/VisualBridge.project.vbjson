{
  "formatVersion": 2,
  "projectId": "visualbridge.sample.pre-unity-authoring",
  "documentRoots": [
    "Logic",
    "Entities",
    "Config",
    "Tables"
  ],
  "modules": [
    {
      "id": "visualbridge.graph",
      "entry": "Modules/graph.vbmodule.js"
    },
    {
      "id": "visualbridge.entity",
      "entry": "Modules/entity.vbmodule.js"
    },
    {
      "id": "visualbridge.structured",
      "entry": "Modules/structured.vbmodule.js"
    },
    {
      "id": "visualbridge.table",
      "entry": "Modules/table.vbmodule.js",
      "options": {
        "tableLayout": {
          "nameKeyRow": 2,
          "dataStartRow": 3
        }
      }
    }
  ],
  "documentTypes": [
    {
      "id": "sample.encounter",
      "editor": "graph",
      "include": [
        "Logic/**/*.encounter"
      ],
      "exclude": [],
      "catalogs": [
        "Catalog/Gameplay.vbgraphcatalog"
      ]
    },
    {
      "id": "sample.hero",
      "editor": "entity",
      "include": [
        "Entities/**/*.character"
      ],
      "exclude": [],
      "catalogs": [
        "Catalog/Gameplay.vbentitycatalog"
      ]
    },
    {
      "id": "sample.settings",
      "editor": "structured",
      "include": [
        "Config/**/*.settingsdata"
      ],
      "exclude": [],
      "catalogs": [
        "Catalog/Gameplay.vbstructuredcatalog"
      ]
    },
    {
      "id": "sample.skills",
      "editor": "table",
      "include": [
        "Tables/**/*.csv"
      ],
      "exclude": [],
      "catalogs": [
        "Catalog/Gameplay.vbtablecatalog"
      ]
    }
  ],
  "providers": [
    {
      "id": "sample.assets",
      "entry": "Providers/sample-provider.mjs",
      "args": [],
      "capabilities": {
        "reference": {
          "kinds": [
            "sample.asset"
          ]
        },
        "validator": {
          "documentTypes": [
            "sample.settings"
          ]
        }
      }
    }
  ]
}
