{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "composite": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "index.ts",
    "Catalog/**/*.ts",
