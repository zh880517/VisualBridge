{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visualbridge.dev/schema/visualbridge-runtime-bridge.schema.json",
  "title": "VisualBridge Runtime Bridge V2",
  "description": "Runtime-mode leg of the unified VisualBridge connection protocol (protocolVersion 4) between the VS Code runtime bridge client and a Unity Runtime instance listener (Editor Play mode or same-machine Player), plus the current per-instance discovery record published at <temp>/visualbridge-runtime/<instanceId>.json. The hello/welcome handshake is the same shape as the editor leg (Appendix A.3): role, clientEndpointId, contractHash, payloads, resumeSessionId on hello; endpointId, sessionId, resumed, connectType, generation, bootId, contractHash, payloads, debugEnabled, startedAt on welcome. This leg still carries the runtime snapshot and artifact-change messages.",
  "oneOf": [
    {
      "$ref": "#/$defs/helloMessage"
    },
    {
      "$ref": "#/$defs/welcomeMessage"
    },
    {
      "$ref": "#/$defs/snapshotRequest"
    },
    {
      "$ref": "#/$defs/responseMessage"
    },
    {
      "$ref": "#/$defs/eventMessage"
    },
    {
      "$ref": "#/$defs/errorMessage"
    }
  ],
  "$defs": {
    "protocolVersion": {
      "const": 4
    },
    "coreVersion": {
      "description": "仅用于 v1 运行时发现记录（formatVersion 1）；握手消息不再携带 coreVersion。",
      "const": 1
    },
    "capability": {
      "description": "仅用于 v1 运行时发现记录；握手改为按 protocolVersion 4 隐含完整能力集，不再协商 capabilities。",
      "enum": [
        "snapshot",
        "events",
        "lease",
        "sources"
      ]
    },
    "capabilityList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "role": {
      "description": "拨号方身份；监听方据此拒绝错配（方向层）。Runtime 腿的拨号方恒为 VS Code。",
      "enum": [
        "vscode"
      ]
    },
    "connectType": {
      "description": "监听方实际承载的连接拓扑；editor-player 对应 Editor Play 模式实例。",
      "enum": [
        "editor-player",
        "player"
      ]
    },
    "payload": {
      "description": "协商的载荷类型；json 必选（Runtime 腿目前只实现 JSON）。",
      "enum": [
        "json",
        "binary"
      ]
    },
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "token": {
      "type": "string",
      "description": "Hex-encoded per-instance authentication token of at least 192 bits. Editor Play mode always publishes one and requires it in hello; a Player without authentication leaves it empty and accepts hello without a token (附录 E.3: token 只用于 editor 模式).",
      "pattern": "^([0-9a-f]{48,64})?$"
    },
    "endpointId": {
      "description": "端点标识（不是调试实例 id）：editor-<pid> / player-<pid>。",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "bootId": {
      "description": "每次进程启动随机生成；Domain Reload 不改变。",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sessionId": {
      "description": "endpointId#bootId；跨 Domain Reload 稳定，generation 不参与。",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}#[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "contractHash": {
      "description": "调试契约指纹：16 位小写十六进制，无契约时为空串。",
      "type": "string",
      "pattern": "^([0-9a-f]{16})?$"
    },
    "payloadList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/payload"
      },
      "contains": {
        "const": "json"
      }
    },
    "debugFilter": {
      "description": "调试筛选：空数组/省略表示全部；服务端在入队前过滤。",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "instanceId": {
      "type": "string",
      "description": "Runtime instance identifier: editor-<pid> for Editor Play mode, player-<pid> for a Player process.",
      "pattern": "^(editor|player)-[0-9]+$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "processId": {
      "type": "integer",
      "minimum": 1
    },
    "instanceKind": {
      "enum": [
        "editor-play",
        "player"
      ]
    },
    "errorCode": {
      "enum": [
        "runtime.alreadyConnected",
        "runtime.internalError",
        "runtime.invalidJson",
        "runtime.invalidMessage",
        "runtime.invalidToken",
        "runtime.leaseDenied",
        "runtime.leaseNotHeld",
        "runtime.leaseRequired",
        "runtime.protocolVersionMismatch",
        "runtime.unknownMessageType",
        "runtime.unknownRequest"
      ]
    },
    "helloMessage": {
      "type": "object",
      "description": "First message sent by the VS Code client after connecting (Appendix A.3): the same handshake shape as the editor leg. role identifies the dialer, clientEndpointId is the dialer endpoint, resumeSessionId asks the listener to resume an existing session.",
      "required": [
        "type",
        "protocolVersion",
        "role",
        "clientEndpointId",
        "contractHash",
        "payloads"
      ],
      "properties": {
        "type": {
          "const": "hello"
        },
        "protocolVersion": {
          "$ref": "#/$defs/protocolVersion"
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "clientEndpointId": {
          "$ref": "#/$defs/endpointId"
        },
        "token": {
          "$ref": "#/$defs/token"
        },
        "contractHash": {
          "$ref": "#/$defs/contractHash"
        },
        "payloads": {
          "$ref": "#/$defs/payloadList"
        },
        "debugCategories": {
          "$ref": "#/$defs/debugFilter"
        },
        "debugInstances": {
          "$ref": "#/$defs/debugFilter"
        },
        "resumeSessionId": {
          "$ref": "#/$defs/sessionId"
        }
      },
      "additionalProperties": false
    },
    "welcomeMessage": {
      "type": "object",
      "description": "Instance reply to a valid hello message (Appendix A.3): identifies the listening endpoint, its session identity and the negotiated payloads.",
      "required": [
        "type",
        "protocolVersion",
        "endpointId",
        "sessionId",
        "resumed",
        "connectType",
        "generation",
        "bootId",
        "contractHash",
        "payloads",
        "debugEnabled",
        "startedAt"
      ],
      "properties": {
        "type": {
          "const": "welcome"
        },
        "protocolVersion": {
          "$ref": "#/$defs/protocolVersion"
        },
        "endpointId": {
          "$ref": "#/$defs/endpointId"
        },
        "sessionId": {
          "$ref": "#/$defs/sessionId"
        },
        "resumed": {
          "type": "boolean"
        },
        "connectType": {
          "$ref": "#/$defs/connectType"
        },
        "generation": {
          "$ref": "#/$defs/generation"
        },
        "bootId": {
          "$ref": "#/$defs/bootId"
        },
        "contractHash": {
          "$ref": "#/$defs/contractHash"
        },
        "payloads": {
          "$ref": "#/$defs/payloadList"
        },
        "debugEnabled": {
          "type": "boolean"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "snapshotRequest": {
      "type": "object",
      "description": "Client request paired with a response by requestId: snapshot queries, debug lease control, and document source mapping.",
      "required": [
        "type",
        "requestId",
        "action"
      ],
      "properties": {
        "type": {
          "const": "request"
        },
        "requestId": {
          "$ref": "#/$defs/requestId"
        },
        "action": {
          "enum": [
            "getSnapshot",
            "acquireLease",
            "releaseLease",
            "getDocumentSources"
          ]
        },
        "documentTypeIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "visualbridge-primitives.schema.json#/$defs/stableId"
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "getSnapshot"
              }
            }
          },
          "then": {},
          "else": {
            "not": {
              "required": [
                "documentTypeIds"
              ]
            }
          }
        }
      ]
    },
    "documentSnapshot": {
      "type": "object",
      "description": "One compiled artifact as served by the runtime instance; the data value is the parsed compiled artifact content.",
      "required": [
        "documentTypeId",
        "documentId",
        "kind",
        "data"
      ],
      "properties": {
        "documentTypeId": {
          "$ref": "visualbridge-primitives.schema.json#/$defs/stableId"
        },
        "documentId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "kind": {
          "type": "string",
          "pattern": "^visualbridge\\.(structured|entity|table|graph)\\.(compiled)$"
        },
        "data": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "responseMessage": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "requestId",
            "status"
          ],
          "properties": {
            "type": {
              "const": "response"
            },
            "requestId": {
              "$ref": "#/$defs/requestId"
            },
            "status": {
              "const": "ok"
            },
            "documents": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/documentSnapshot"
              }
            },
            "sources": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/documentSource"
              }
            }
          },
          "additionalProperties": false,
          "description": "Successful response: exactly one payload shape - documents (snapshot), sources (source mapping), or no payload (lease control).",
          "oneOf": [
            {
              "required": [
                "documents"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "sources"
                    ]
                  }
                ]
              }
            },
            {
              "required": [
                "sources"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "documents"
                    ]
                  }
                ]
              }
            },
            {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "documents"
                    ]
                  },
                  {
                    "required": [
                      "sources"
                    ]
                  }
                ]
              }
            }
          ]
        },
        {
          "type": "object",
          "required": [
            "type",
            "requestId",
            "status",
            "error"
          ],
          "properties": {
            "type": {
              "const": "response"
            },
            "requestId": {
              "$ref": "#/$defs/requestId"
            },
            "status": {
              "const": "error"
            },
            "error": {
              "$ref": "#/$defs/errorCode"
            },
            "detail": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "eventMessage": {
      "type": "object",
      "description": "Compiled artifact change notification pushed to a connected client with the events capability.",
      "required": [
        "type",
        "event",
        "documents"
      ],
      "properties": {
        "type": {
          "const": "event"
        },
        "event": {
          "const": "artifactsChanged"
        },
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/documentSnapshot"
          }
        }
      },
      "additionalProperties": false
    },
    "errorMessage": {
      "type": "object",
      "description": "Connection-level failure report sent before the instance closes the connection.",
      "required": [
        "type",
        "code"
      ],
      "properties": {
        "type": {
          "const": "error"
        },
        "code": {
          "$ref": "#/$defs/errorCode"
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "additionalProperties": false
    },
    "tcpPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "discoveryRecord": {
      "type": "object",
      "description": "Per-instance discovery record published at <temp>/visualbridge-runtime/<instanceId>.json; heartbeat is the file modification time. Staleness is heartbeat older than 5 seconds or a dead pid.",
      "required": [
        "formatVersion",
        "protocolVersion",
        "coreVersion",
        "instanceId",
        "kind",
        "capabilities",
        "tcpPort",
        "token",
        "pid",
        "generation",
        "startedAt"
      ],
      "properties": {
        "formatVersion": {
          "const": 1
        },
        "protocolVersion": {
          "$ref": "#/$defs/protocolVersion"
        },
        "coreVersion": {
          "$ref": "#/$defs/coreVersion"
        },
        "instanceId": {
          "$ref": "#/$defs/instanceId"
        },
        "kind": {
          "$ref": "#/$defs/instanceKind"
        },
        "capabilities": {
          "$ref": "#/$defs/capabilityList"
        },
        "tcpPort": {
          "$ref": "#/$defs/tcpPort"
        },
        "token": {
          "$ref": "#/$defs/token"
        },
        "pid": {
          "$ref": "#/$defs/processId"
        },
        "generation": {
          "$ref": "#/$defs/generation"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "documentSource": {
      "type": "object",
      "description": "Authoring source mapping for one runtime document, derived from the compiled artifact inputs.",
      "required": [
        "documentTypeId",
        "documentId",
        "sourcePath",
        "sourceSha256"
      ],
      "properties": {
        "documentTypeId": {
          "$ref": "visualbridge-primitives.schema.json#/$defs/stableId"
        },
        "documentId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "sourcePath": {
          "$ref": "visualbridge-primitives.schema.json#/$defs/normalizedPath"
        },
        "sourceSha256": {
          "$ref": "visualbridge-primitives.schema.json#/$defs/sha256"
        }
      },
      "additionalProperties": false
    }
  }
}
