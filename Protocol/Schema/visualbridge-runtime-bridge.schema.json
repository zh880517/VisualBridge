{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visualbridge.dev/schema/visualbridge-runtime-bridge.schema.json",
  "title": "VisualBridge Runtime Bridge V1",
  "description": "Local NDJSON message contracts between the VS Code runtime bridge client and a Unity Runtime instance listener (Editor Play mode or same-machine Player), plus the per-instance discovery record published at <temp>/visualbridge-runtime/<instanceId>.json. The hello/welcome/error shapes realize the shared bridge protocol core (coreVersion 1) established by the Editor Bridge; this channel carries runtime snapshots, artifact-change events, and capability-gated graph execution observation (subscribe + batched execution events, no breakpoints). Execution-level debug messages (breakpoints, call stacks, variable evaluation) remain out of scope by design.",
  "oneOf": [
    {
      "$ref": "#/$defs/helloMessage"
    },
    {
      "$ref": "#/$defs/welcomeMessage"
    },
    {
      "$ref": "#/$defs/snapshotRequest"
    },
    {
      "$ref": "#/$defs/responseMessage"
    },
    {
      "$ref": "#/$defs/eventMessage"
    },
    {
      "$ref": "#/$defs/errorMessage"
    }
  ],
  "$defs": {
    "protocolVersion": {
      "const": 1
    },
    "coreVersion": {
      "const": 1
    },
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "token": {
      "type": "string",
      "description": "Hex-encoded per-instance authentication token of at least 192 bits.",
      "pattern": "^[0-9a-f]{48,64}$"
    },
    "instanceId": {
      "type": "string",
      "description": "Runtime instance identifier: editor-<pid> for Editor Play mode, player-<pid> for a Player process.",
      "pattern": "^(editor|player)-[0-9]+$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "processId": {
      "type": "integer",
      "minimum": 1
    },
    "instanceKind": {
      "enum": [
        "editor-play",
        "player"
      ]
    },
    "capability": {
      "enum": [
        "snapshot",
        "events",
        "lease",
        "sources",
        "graphExecution"
      ]
    },
    "capabilityList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "errorCode": {
      "enum": [
        "runtime.capabilityMissing",
        "runtime.executionNotFound",
        "runtime.internalError",
        "runtime.invalidJson",
        "runtime.invalidMessage",
        "runtime.invalidToken",
        "runtime.leaseDenied",
        "runtime.leaseNotHeld",
        "runtime.leaseRequired",
        "runtime.protocolVersionMismatch",
        "runtime.unknownMessageType",
        "runtime.unknownRequest"
      ]
    },
    "helloMessage": {
      "type": "object",
      "description": "First message sent by the VS Code client after connecting; authenticates the connection and negotiates the protocol, core and capability set.",
      "required": [
        "type",
        "protocolVersion",
        "coreVersion",
        "token",
        "clientInstanceId",
        "capabilities"
      ],
      "properties": {
        "type": {
          "const": "hello"
        },
        "protocolVersion": {
          "$ref": "#/$defs/protocolVersion"
        },
        "coreVersion": {
          "$ref": "#/$defs/coreVersion"
        },
        "token": {
          "$ref": "#/$defs/token"
        },
        "clientInstanceId": {
          "type": "string",
          "format": "uuid"
        },
        "capabilities": {
          "$ref": "#/$defs/capabilityList"
        }
      },
      "additionalProperties": false
    },
    "welcomeMessage": {
      "type": "object",
      "description": "Instance reply to a valid hello message; identifies the runtime instance, its kind and the current generation.",
      "required": [
        "type",
        "protocolVersion",
        "coreVersion",
        "instanceId",
        "kind",
        "generation",
        "capabilities",
        "startedAt"
      ],
      "properties": {
        "type": {
          "const": "welcome"
        },
        "protocolVersion": {
          "$ref": "#/$defs/protocolVersion"
        },
        "coreVersion": {
          "$ref": "#/$defs/coreVersion"
        },
        "instanceId": {
          "$ref": "#/$defs/instanceId"
        },
        "kind": {
          "$ref": "#/$defs/instanceKind"
        },
        "generation": {
          "$ref": "#/$defs/generation"
        },
        "capabilities": {
          "$ref": "#/$defs/capabilityList"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "snapshotRequest": {
      "type": "object",
      "description": "Client request paired with a response by requestId: snapshot queries, debug lease control, document source mapping, and graph execution observation (capability 'graphExecution').",
      "required": [
        "type",
        "requestId",
        "action"
      ],
      "properties": {
        "type": {
          "const": "request"
        },
        "requestId": {
          "$ref": "#/$defs/requestId"
        },
        "action": {
          "enum": [
            "getSnapshot",
            "acquireLease",
            "releaseLease",
            "getDocumentSources",
            "getGraphExecutionInstances",
            "subscribeGraphExecution",
            "unsubscribeGraphExecution",
            "getGraphExecutionSnapshot"
          ]
        },
        "documentTypeIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "visualbridge-primitives.schema.json#/$defs/stableId"
          }
        },
        "documentId": {
          "type": "string",
          "description": "Optional graph document filter for getGraphExecutionInstances.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "executionId": {
          "type": "string",
          "description": "Graph execution instance identifier assigned by the runtime; required by subscribe/unsubscribe/getGraphExecutionSnapshot.",
          "pattern": "^exec-[0-9]+$"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "getSnapshot"
              }
            }
          },
          "then": {},
          "else": {
            "not": {
              "required": [
                "documentTypeIds"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "getGraphExecutionInstances"
              }
            }
          },
          "then": {},
          "else": {
            "not": {
              "required": [
                "documentId"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "getGraphExecutionInstances"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "executionId"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "getSnapshot"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "executionId"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "acquireLease"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "executionId"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "releaseLease"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "executionId"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "getDocumentSources"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "executionId"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "subscribeGraphExecution"
              }
            }
          },
          "then": {
            "required": [
              "executionId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "unsubscribeGraphExecution"
              }
            }
          },
          "then": {
            "required": [
              "executionId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "getGraphExecutionSnapshot"
              }
            }
          },
          "then": {
            "required": [
              "executionId"
            ]
          }
        }
      ]
    },
    "documentSnapshot": {
      "type": "object",
      "description": "One compiled artifact as served by the runtime instance; the data value is the parsed compiled artifact content.",
      "required": [
        "documentTypeId",
        "documentId",
        "kind",
        "data"
      ],
      "properties": {
        "documentTypeId": {
          "$ref": "visualbridge-primitives.schema.json#/$defs/stableId"
        },
        "documentId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "kind": {
          "type": "string",
          "pattern": "^visualbridge\\.(structured|entity|table|graph)\\.(compiled)$"
        },
        "data": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "responseMessage": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "requestId",
            "status"
          ],
          "properties": {
            "type": {
              "const": "response"
            },
            "requestId": {
              "$ref": "#/$defs/requestId"
            },
            "status": {
              "const": "ok"
            },
            "documents": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/documentSnapshot"
              }
            },
            "sources": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/documentSource"
              }
            },
            "executions": {
              "type": "array",
              "description": "Active graph execution instances for getGraphExecutionInstances.",
              "items": {
                "$ref": "#/$defs/graphExecutionInstance"
              }
            },
            "execution": {
              "description": "Shallow snapshot for getGraphExecutionSnapshot.",
              "$ref": "#/$defs/graphExecutionInstance"
            }
          },
          "additionalProperties": false,
          "description": "Successful response: exactly one payload shape - documents (snapshot), sources (source mapping), executions (instance list), execution (shallow snapshot), or no payload (lease and subscription control).",
          "oneOf": [
            {
              "required": [
                "documents"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "sources"
                    ]
                  },
                  {
                    "required": [
                      "executions"
                    ]
                  },
                  {
                    "required": [
                      "execution"
                    ]
                  }
                ]
              }
            },
            {
              "required": [
                "sources"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "documents"
                    ]
                  },
                  {
                    "required": [
                      "executions"
                    ]
                  },
                  {
                    "required": [
                      "execution"
                    ]
                  }
                ]
              }
            },
            {
              "required": [
                "executions"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "documents"
                    ]
                  },
                  {
                    "required": [
                      "sources"
                    ]
                  },
                  {
                    "required": [
                      "execution"
                    ]
                  }
                ]
              }
            },
            {
              "required": [
                "execution"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "documents"
                    ]
                  },
                  {
                    "required": [
                      "sources"
                    ]
                  },
                  {
                    "required": [
                      "executions"
                    ]
                  }
                ]
              }
            },
            {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "documents"
                    ]
                  },
                  {
                    "required": [
                      "sources"
                    ]
                  },
                  {
                    "required": [
                      "executions"
                    ]
                  },
                  {
                    "required": [
                      "execution"
                    ]
                  }
                ]
              }
            }
          ]
        },
        {
          "type": "object",
          "required": [
            "type",
            "requestId",
            "status",
            "error"
          ],
          "properties": {
            "type": {
              "const": "response"
            },
            "requestId": {
              "$ref": "#/$defs/requestId"
            },
            "status": {
              "const": "error"
            },
            "error": {
              "$ref": "#/$defs/errorCode"
            },
            "detail": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "eventMessage": {
      "oneOf": [
        {
          "type": "object",
          "description": "Compiled artifact change notification pushed to a connected client with the events capability.",
          "required": [
            "type",
            "event",
            "documents"
          ],
          "properties": {
            "type": {
              "const": "event"
            },
            "event": {
              "const": "artifactsChanged"
            },
            "documents": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/documentSnapshot"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Batched graph execution events pushed to a client subscribed to an execution instance (capability 'graphExecution'); flushed every 100ms or 64 events.",
          "required": [
            "type",
            "event",
            "executionEvents"
          ],
          "properties": {
            "type": {
              "const": "event"
            },
            "event": {
              "const": "graphExecution"
            },
            "executionEvents": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/graphExecutionEvent"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "errorMessage": {
      "type": "object",
      "description": "Connection-level failure report sent before the instance closes the connection.",
      "required": [
        "type",
        "code"
      ],
      "properties": {
        "type": {
          "const": "error"
        },
        "code": {
          "$ref": "#/$defs/errorCode"
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "additionalProperties": false
    },
    "tcpPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "discoveryRecord": {
      "type": "object",
      "description": "Per-instance discovery record published at <temp>/visualbridge-runtime/<instanceId>.json; heartbeat is the file modification time. Staleness is heartbeat older than 5 seconds or a dead pid.",
      "required": [
        "formatVersion",
        "protocolVersion",
        "coreVersion",
        "instanceId",
        "kind",
        "capabilities",
        "tcpPort",
        "token",
        "pid",
        "generation",
        "startedAt"
      ],
      "properties": {
        "formatVersion": {
          "const": 1
        },
        "protocolVersion": {
          "$ref": "#/$defs/protocolVersion"
        },
        "coreVersion": {
          "$ref": "#/$defs/coreVersion"
        },
        "instanceId": {
          "$ref": "#/$defs/instanceId"
        },
        "kind": {
          "$ref": "#/$defs/instanceKind"
        },
        "capabilities": {
          "$ref": "#/$defs/capabilityList"
        },
        "tcpPort": {
          "$ref": "#/$defs/tcpPort"
        },
        "token": {
          "$ref": "#/$defs/token"
        },
        "pid": {
          "$ref": "#/$defs/processId"
        },
        "generation": {
          "$ref": "#/$defs/generation"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "documentSource": {
      "type": "object",
      "description": "Authoring source mapping for one runtime document, derived from the compiled artifact inputs.",
      "required": [
        "documentTypeId",
        "documentId",
        "sourcePath",
        "sourceSha256"
      ],
      "properties": {
        "documentTypeId": {
          "$ref": "visualbridge-primitives.schema.json#/$defs/stableId"
        },
        "documentId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "sourcePath": {
          "$ref": "visualbridge-primitives.schema.json#/$defs/normalizedPath"
        },
        "sourceSha256": {
          "$ref": "visualbridge-primitives.schema.json#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "graphExecutionInstance": {
      "type": "object",
      "description": "One graph execution instance: a single run of one graph document by one game-side executor (debugKey); executionId is assigned by the runtime capture facade. Also serves as the shallow snapshot payload (current node + running state, no variable dump).",
      "required": [
        "executionId",
        "documentTypeId",
        "documentId",
        "graphName",
        "debugKey",
        "state",
        "currentNodeId",
        "frameIndex"
      ],
      "properties": {
        "executionId": {
          "type": "string",
          "pattern": "^exec-[0-9]+$"
        },
        "documentTypeId": {
          "$ref": "visualbridge-primitives.schema.json#/$defs/stableId"
        },
        "documentId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "graphName": {
          "type": "string",
          "description": "Game-side display name of the executed graph.",
          "minLength": 1,
          "maxLength": 256
        },
        "debugKey": {
          "type": "string",
          "description": "Game-side executor identity (for example which character runs the graph); may be empty.",
          "maxLength": 256
        },
        "state": {
          "enum": [
            "running",
            "stopped"
          ]
        },
        "currentNodeId": {
          "description": "Stable node identifier of the current node, or null when the execution has no current node.",
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "frameIndex": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "graphExecutionEvent": {
      "type": "object",
      "description": "One execution observation event; nodeId is the VisualBridge document's stable node identifier. Field presence is coupled to the event kind.",
      "required": [
        "executionId",
        "frameIndex",
        "kind"
      ],
      "properties": {
        "executionId": {
          "type": "string",
          "pattern": "^exec-[0-9]+$"
        },
        "frameIndex": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "enum": [
            "instanceStarted",
            "instanceStopped",
            "nodeStart",
            "nodeOutput",
            "dataNode",
            "edgeValueChanged"
          ]
        },
        "nodeId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "outputIndex": {
          "type": "integer",
          "minimum": 0
        },
        "value": {
          "type": "string",
          "description": "Stringified value carried by a data edge, provided by the game-side engine.",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "instanceStarted"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "nodeId"
                  ]
                },
                {
                  "required": [
                    "outputIndex"
                  ]
                },
                {
                  "required": [
                    "value"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "instanceStopped"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "nodeId"
                  ]
                },
                {
                  "required": [
                    "outputIndex"
                  ]
                },
                {
                  "required": [
                    "value"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "nodeStart"
              }
            }
          },
          "then": {
            "required": [
              "nodeId"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "outputIndex"
                  ]
                },
                {
                  "required": [
                    "value"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "dataNode"
              }
            }
          },
          "then": {
            "required": [
              "nodeId"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "outputIndex"
                  ]
                },
                {
                  "required": [
                    "value"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "nodeOutput"
              }
            }
          },
          "then": {
            "required": [
              "nodeId",
              "outputIndex"
            ],
            "not": {
              "required": [
                "value"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "edgeValueChanged"
              }
            }
          },
          "then": {
            "required": [
              "nodeId",
              "outputIndex",
              "value"
            ]
          }
        }
      ]
    }
  }
}
