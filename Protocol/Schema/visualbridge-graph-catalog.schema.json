{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visualbridge.dev/schema/visualbridge-graph-catalog.schema.json",
  "title": "VisualBridge Graph Catalog",
  "type": "object",
  "required": ["formatVersion", "catalogId", "title", "source", "dataTypes", "graphTypes", "nodeTypes"],
  "properties": {
    "formatVersion": { "const": 4 },
    "catalogId": { "$ref": "#/$defs/identifier" },
    "title": { "type": "string", "minLength": 1 },
    "source": { "$ref": "#/$defs/catalogSource" },
    "dataTypes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "title": { "type": "string" },
          "color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "acceptsAnySource": {
            "type": "boolean",
            "default": false
          },
          "accepts": {
            "type": "array",
            "items": { "$ref": "#/$defs/identifier" },
            "default": []
          }
        },
        "additionalProperties": false
      }
    },
    "graphTypes": {
      "type": "array",
      "items": { "$ref": "#/$defs/graphType" }
    },
    "nodeTypes": {
      "type": "array",
      "items": { "$ref": "#/$defs/nodeType" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "catalogSource": {
      "$ref": "visualbridge-catalog-source.schema.json"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "nonEmptyString": {
      "type": "string",
      "pattern": "\\S"
    },
    "identifierArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "port": {
      "type": "object",
      "required": ["id", "title", "kind", "direction"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "aliases": { "$ref": "#/$defs/identifierArray", "default": [] },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "kind": { "enum": ["flow", "data"] },
        "direction": { "enum": ["input", "output"] },
        "dataTypeId": { "$ref": "#/$defs/identifier" },
        "maxConnections": { "type": "integer", "minimum": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "data" } } },
          "then": { "required": ["dataTypeId"] },
          "else": { "not": { "required": ["dataTypeId"] } }
        }
      ],
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "required": ["id", "title", "valueType", "defaultValue"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "aliases": { "$ref": "#/$defs/identifierArray", "default": [] },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "valueType": { "$ref": "#/$defs/valueType" },
        "dataTypeId": { "$ref": "#/$defs/identifier" },
        "defaultValue": true,
        "editor": { "$ref": "#/$defs/editor" },
        "reference": { "$ref": "#/$defs/reference" },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        },
        "item": { "$ref": "#/$defs/valueDefinition" }
      },
      "allOf": [
        { "$ref": "#/$defs/valueShape" }
      ],
      "additionalProperties": false
    },
    "valueType": {
      "enum": ["string", "number", "boolean", "object", "array", "json"]
    },
    "valueShape": {
      "type": "object",
      "if": {
        "type": "object",
        "properties": { "valueType": { "const": "object" } },
        "required": ["valueType"]
      },
      "then": {
        "type": "object",
        "required": ["fields"],
        "properties": { "fields": true, "item": false }
      },
      "else": {
        "if": {
          "type": "object",
          "properties": { "valueType": { "const": "array" } },
          "required": ["valueType"]
        },
        "then": {
          "type": "object",
          "required": ["item"],
          "properties": { "item": true, "fields": false }
        },
        "else": {
          "type": "object",
          "properties": { "fields": false, "item": false }
        }
      }
    },
    "reference": {
      "type": "object",
      "required": ["kind", "target"],
      "properties": {
        "kind": { "$ref": "#/$defs/identifier" },
        "target": { "$ref": "visualbridge-primitives.schema.json#/$defs/jsonObject" },
        "allowMissing": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "editorOption": {
      "type": "object",
      "required": ["title", "value"],
      "properties": {
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "value": true
      },
      "additionalProperties": false
    },
    "editor": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["text", "multiline", "number", "checkbox", "select", "color", "reference", "json"] },
        "readOnly": { "type": "boolean", "default": false },
        "integer": { "type": "boolean", "default": false },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number", "exclusiveMinimum": 0 },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/editorOption" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "select" } }, "required": ["kind"] },
          "then": { "required": ["options"], "properties": { "options": true } },
          "else": { "properties": { "options": false } }
        }
      ],
      "additionalProperties": false
    },
    "dynamicPortTemplate": {
      "type": "object",
      "required": ["kind", "direction"],
      "properties": {
        "kind": { "enum": ["flow", "data"] },
        "direction": { "enum": ["input", "output"] },
        "dataTypeId": { "$ref": "#/$defs/identifier" },
        "maxConnections": { "type": "integer", "minimum": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "data" } }, "required": ["kind"] },
          "then": { "required": ["dataTypeId"] },
          "else": { "not": { "required": ["dataTypeId"] } }
        }
      ],
      "additionalProperties": false
    },
    "valueDefinition": {
      "type": "object",
      "required": ["valueType", "defaultValue"],
      "properties": {
        "valueType": { "$ref": "#/$defs/valueType" },
        "dataTypeId": { "$ref": "#/$defs/identifier" },
        "defaultValue": true,
        "editor": { "$ref": "#/$defs/editor" },
        "reference": { "$ref": "#/$defs/reference" },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        },
        "item": { "$ref": "#/$defs/valueDefinition" }
      },
      "allOf": [
        { "$ref": "#/$defs/valueShape" }
      ],
      "additionalProperties": false
    },
    "dynamicPortGroup": {
      "type": "object",
      "required": ["id", "title", "port", "item"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "aliases": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "default": []
        },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "listPortMode": { "enum": ["list", "element"] },
        "port": { "$ref": "#/$defs/dynamicPortTemplate" },
        "item": { "$ref": "#/$defs/valueDefinition" },
        "maxItems": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "nodeSource": {
      "type": "object",
      "required": ["providerId", "typeName"],
      "properties": {
        "providerId": { "$ref": "#/$defs/identifier" },
        "assemblyName": { "type": "string" },
        "typeName": { "type": "string", "minLength": 1 },
        "wrapperTypeName": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "nodeSelector": {
      "type": "object",
      "properties": {
        "nodeTypeIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "traits": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/identifier" }
        }
      },
      "anyOf": [
        { "required": ["nodeTypeIds"] },
        { "required": ["tags"] },
        { "required": ["traits"] }
      ],
      "additionalProperties": false
    },
    "nodeConstraint": {
      "type": "object",
      "required": ["id", "selector"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "selector": { "$ref": "#/$defs/nodeSelector" },
        "minInstances": { "type": "integer", "minimum": 0 },
        "maxInstances": { "type": "integer", "minimum": 0 }
      },
      "anyOf": [
        { "required": ["minInstances"] },
        { "required": ["maxInstances"] }
      ],
      "additionalProperties": false
    },
    "initialNode": {
      "type": "object",
      "required": ["nodeTypeId"],
      "properties": {
        "nodeTypeId": { "$ref": "#/$defs/identifier" },
        "title": { "type": "string" }
      },
      "additionalProperties": false
    },
    "graphType": {
      "type": "object",
      "required": ["id", "title", "supportedCatalogIds", "portConnectionRules", "properties"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "aliases": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "default": []
        },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "usage": { "enum": ["root", "subgraph", "any"], "default": "any" },
        "source": { "$ref": "#/$defs/nodeSource" },
        "supportedCatalogIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "portConnectionRules": { "$ref": "#/$defs/portConnectionRules" },
        "allowedNodeSelectors": {
          "type": "array",
          "items": { "$ref": "#/$defs/nodeSelector" }
        },
        "properties": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        },
        "nodeConstraints": {
          "type": "array",
          "items": { "$ref": "#/$defs/nodeConstraint" },
          "default": []
        },
        "initialNodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/initialNode" },
          "default": []
        },
        "allowSubgraphs": { "type": "boolean", "default": true },
        "allowedSubgraphTypeIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "allowSubgraphs": { "const": false } }, "required": ["allowSubgraphs"] },
          "then": { "not": { "required": ["allowedSubgraphTypeIds"] } }
        }
      ],
      "additionalProperties": false
    },
    "portConnectionRules": {
      "type": "object",
      "required": ["input", "output"],
      "properties": {
        "input": { "enum": ["single", "multiple"] },
        "output": { "enum": ["single", "multiple"] }
      },
      "additionalProperties": false
    },
    "subgraphNodeContract": {
      "type": "object",
      "properties": {
        "graphTypeIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" }
        }
      },
      "additionalProperties": false
    },
    "nodeType": {
      "type": "object",
      "required": ["id", "title", "category", "ports", "properties"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "aliases": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "default": []
        },
        "title": { "type": "string" },
        "icon": { "type": "string", "minLength": 1 },
        "category": { "type": "string" },
        "menuPath": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        },
        "tags": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "default": []
        },
        "traits": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "default": []
        },
        "source": { "$ref": "#/$defs/nodeSource" },
        "subgraph": { "$ref": "#/$defs/subgraphNodeContract" },
        "ports": {
          "type": "array",
          "items": { "$ref": "#/$defs/port" }
        },
        "dynamicPortGroups": {
          "type": "array",
          "items": { "$ref": "#/$defs/dynamicPortGroup" },
          "default": []
        },
        "properties": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        }
      },
      "additionalProperties": false
    }
  }
}
