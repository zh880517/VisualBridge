{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visualbridge.dev/schema/visualbridge-graph.schema.json",
  "title": "VisualBridge Graph Document",
  "type": "object",
  "required": ["formatVersion", "documentId", "rootGraphId", "graphs"],
  "properties": {
    "formatVersion": { "const": 3 },
    "documentId": { "$ref": "#/$defs/identifier" },
    "rootGraphId": { "$ref": "#/$defs/identifier" },
    "graphs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/graph" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "position": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      },
      "additionalProperties": false
    },
    "properties": {
      "$ref": "visualbridge-primitives.schema.json#/$defs/jsonObject"
    },
    "interfacePort": {
      "type": "object",
      "required": ["id", "title", "kind", "direction"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "title": { "type": "string" },
        "kind": { "enum": ["flow", "data"] },
        "direction": { "enum": ["input", "output"] },
        "dataTypeId": { "$ref": "#/$defs/identifier" },
        "maxConnections": { "type": "integer", "minimum": 1 },
        "dynamic": { "type": "boolean", "default": false }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "data" } } },
          "then": { "required": ["dataTypeId"] },
          "else": {
            "allOf": [
              { "not": { "required": ["dataTypeId"] } },
              { "not": { "properties": { "dynamic": { "const": true } }, "required": ["dynamic"] } }
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "atomicNode": {
      "type": "object",
      "required": ["kind", "id", "nodeTypeId", "title", "position", "properties"],
      "properties": {
        "kind": { "const": "node" },
        "id": { "$ref": "#/$defs/identifier" },
        "nodeTypeId": { "$ref": "#/$defs/identifier" },
        "title": { "type": "string" },
        "position": { "$ref": "#/$defs/position" },
        "properties": { "$ref": "#/$defs/properties" },
        "dynamicPorts": {
          "type": "array",
          "items": { "$ref": "#/$defs/dynamicPort" },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "dynamicPort": {
      "type": "object",
      "required": ["id", "groupId", "title", "value"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "groupId": { "$ref": "#/$defs/identifier" },
        "title": { "type": "string" },
        "value": { "$ref": "visualbridge-primitives.schema.json#/$defs/jsonValue" }
      },
      "additionalProperties": false
    },
    "subgraphNode": {
      "type": "object",
      "required": ["kind", "id", "subgraphId", "title", "position", "properties"],
      "properties": {
        "kind": { "const": "subgraph" },
        "id": { "$ref": "#/$defs/identifier" },
        "nodeTypeId": { "$ref": "#/$defs/identifier" },
        "subgraphId": { "$ref": "#/$defs/identifier" },
        "title": { "type": "string" },
        "position": { "$ref": "#/$defs/position" },
        "properties": { "$ref": "#/$defs/properties" },
        "dynamicPorts": {
          "type": "array",
          "items": { "$ref": "#/$defs/dynamicPort" },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "nodeEndpoint": {
      "type": "object",
      "required": ["kind", "nodeId", "portId"],
      "properties": {
        "kind": { "const": "node" },
        "nodeId": { "$ref": "#/$defs/identifier" },
        "portId": { "$ref": "#/$defs/identifier" }
      },
      "additionalProperties": false
    },
    "interfaceEndpoint": {
      "type": "object",
      "required": ["kind", "portId"],
      "properties": {
        "kind": { "const": "interface" },
        "portId": { "$ref": "#/$defs/identifier" }
      },
      "additionalProperties": false
    },
    "endpoint": {
      "oneOf": [
        { "$ref": "#/$defs/nodeEndpoint" },
        { "$ref": "#/$defs/interfaceEndpoint" }
      ]
    },
    "edge": {
      "type": "object",
      "required": ["id", "kind", "source", "target"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["flow", "data"] },
        "source": { "$ref": "#/$defs/endpoint" },
        "target": { "$ref": "#/$defs/endpoint" }
      },
      "additionalProperties": false
    },
    "graph": {
      "type": "object",
      "required": ["id", "title", "properties", "interfacePorts", "nodes", "edges"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "graphTypeId": { "$ref": "#/$defs/identifier" },
        "title": { "type": "string" },
        "properties": { "$ref": "#/$defs/properties" },
        "interfacePorts": {
          "type": "array",
          "items": { "$ref": "#/$defs/interfacePort" }
        },
        "nodes": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/atomicNode" },
              { "$ref": "#/$defs/subgraphNode" }
            ]
          }
        },
        "edges": {
          "type": "array",
          "items": { "$ref": "#/$defs/edge" }
        }
      },
      "additionalProperties": false
    }
  }
}
