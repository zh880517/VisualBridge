{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visualbridge.dev/schema/visualbridge-graph.schema.json",
  "title": "VisualBridge Graph Document",
  "type": "object",
  "required": [
    "formatVersion",
    "documentId",
    "nodes",
    "edges"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "documentId": {
      "$ref": "#/$defs/identifier"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "title",
          "position",
          "properties"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "type": {
            "$ref": "#/$defs/identifier"
          },
          "title": {
            "type": "string"
          },
          "position": {
            "$ref": "#/$defs/position"
          },
          "properties": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "target"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "source": {
            "$ref": "#/$defs/endpoint"
          },
          "target": {
            "$ref": "#/$defs/endpoint"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "position": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "endpoint": {
      "type": "object",
      "required": [
        "nodeId",
        "portId"
      ],
      "properties": {
        "nodeId": {
          "$ref": "#/$defs/identifier"
        },
        "portId": {
          "$ref": "#/$defs/identifier"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
