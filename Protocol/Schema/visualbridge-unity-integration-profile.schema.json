{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visualbridge.dev/schema/visualbridge-unity-integration-profile.schema.json",
  "title": "VisualBridge Unity Integration Profile V1",
  "description": "ProjectSettings profile for deterministic Unity-to-VisualBridge catalog export and derived-data compilation.",
  "type": "object",
  "required": [
    "formatVersion",
    "authoringProject",
    "catalogExports",
    "compileOutputRoot"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "authoringProject": {
      "$ref": "#/$defs/projectRelativePath"
    },
    "catalogExports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/catalogExport"
      }
    },
    "compileOutputRoot": {
      "$ref": "#/$defs/projectRelativePath"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "nonEmptyString": {
      "type": "string",
      "pattern": "\\S"
    },
    "projectRelativePath": {
      "type": "string",
      "description": "A normalized forward-slash path resolved lexically from the Unity project root. Absolute paths, dot segments, empty segments, backslashes and root aliases are forbidden.",
      "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*//)(?:[^/]+/)*[^/]+$"
    },
    "catalogExport": {
      "type": "object",
      "required": [
        "catalogId",
        "title",
        "output",
        "types"
      ],
      "properties": {
        "catalogId": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "output": {
          "allOf": [
            { "$ref": "#/$defs/projectRelativePath" },
            {
              "type": "string",
              "description": "The file extension routes the export unit: .vbstructuredcatalog uses the Structured Catalog Exporter, .vbentitycatalog uses the Entity Catalog Exporter.",
              "pattern": "\\.(vbstructuredcatalog|vbentitycatalog)$"
            }
          ]
        },
        "types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "description": "An explicitly registered assembly-qualified CLR type name.",
            "pattern": "^(?!.*[\\u0000-\\u001F\\u007F-\\u009F])\\S(?:.*\\S)?,\\s*\\S(?:.*\\S)?$"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
