{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visualbridge.dev/schema/visualbridge-authoring-contracts.schema.json",
  "title": "VisualBridge Authoring Transport Contracts V1",
  "$defs": {
    "graphOperation": {
      "oneOf": [
        { "$ref": "#/$defs/graphRenameElement" },
        { "$ref": "#/$defs/graphAddNode" },
        { "$ref": "#/$defs/graphAddSubgraph" },
        { "$ref": "#/$defs/graphRemoveNode" },
        { "$ref": "#/$defs/graphMoveNode" },
        { "$ref": "#/$defs/graphUpdateNode" },
        { "$ref": "#/$defs/graphReplaceNodeType" },
        { "$ref": "#/$defs/graphAddDynamicPort" },
        { "$ref": "#/$defs/graphUpdateDynamicPort" },
        { "$ref": "#/$defs/graphRemoveDynamicPort" },
        { "$ref": "#/$defs/graphReorderDynamicPorts" },
        { "$ref": "#/$defs/graphAddEdge" },
        { "$ref": "#/$defs/graphRemoveEdge" },
        { "$ref": "#/$defs/graphAssignType" },
        { "$ref": "#/$defs/graphUpdateGraph" },
        { "$ref": "#/$defs/graphAddInterfacePort" },
        { "$ref": "#/$defs/graphUpdateInterfacePort" },
        { "$ref": "#/$defs/graphRemoveInterfacePort" },
        { "$ref": "#/$defs/graphReorderInterfacePorts" }
      ]
    },
    "graphRenameElement": {
      "type": "object", "required": ["type", "graphId", "elementKind", "elementId", "newElementId"],
      "properties": { "type": { "const": "graph.renameElement" }, "graphId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "elementKind": { "enum": ["graph", "node", "interfacePort", "dynamicPort"] }, "elementId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "newElementId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "nodeId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" } }, "additionalProperties": false
    },
    "graphAddNode": { "type": "object", "required": ["type", "graphId", "node"], "properties": { "type": { "const": "graph.addNode" }, "graphId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "node": { "$ref": "visualbridge-graph.schema.json#/$defs/atomicNode" } }, "additionalProperties": false },
    "graphAddSubgraph": { "type": "object", "required": ["type", "graphId", "node", "subgraph"], "properties": { "type": { "const": "graph.addSubgraph" }, "graphId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "node": { "$ref": "visualbridge-graph.schema.json#/$defs/subgraphNode" }, "subgraph": { "$ref": "visualbridge-graph.schema.json#/$defs/graph" } }, "additionalProperties": false },
    "graphRemoveNode": { "$ref": "#/$defs/graphNodeIdOperation" },
    "graphMoveNode": { "type": "object", "required": ["type", "graphId", "nodeId", "position"], "properties": { "type": { "const": "graph.moveNode" }, "graphId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "nodeId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "position": { "$ref": "visualbridge-graph.schema.json#/$defs/position" } }, "additionalProperties": false },
    "graphUpdateNode": { "type": "object", "required": ["type", "graphId", "nodeId", "title", "properties"], "properties": { "type": { "const": "graph.updateNode" }, "graphId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "nodeId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "title": { "type": "string" }, "properties": { "$ref": "visualbridge-primitives.schema.json#/$defs/jsonObject" } }, "additionalProperties": false },
    "graphReplaceNodeType": { "type": "object", "required": ["type", "graphId", "nodeId", "nodeTypeId"], "properties": { "type": { "const": "graph.replaceNodeType" }, "graphId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "nodeId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "nodeTypeId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" } }, "additionalProperties": false },
    "graphAddDynamicPort": { "type": "object", "required": ["type", "graphId", "nodeId", "port"], "properties": { "type": { "const": "graph.addDynamicPort" }, "graphId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "nodeId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "port": { "$ref": "visualbridge-graph.schema.json#/$defs/dynamicPort" } }, "additionalProperties": false },
    "graphUpdateDynamicPort": { "type": "object", "required": ["type", "graphId", "nodeId", "portId", "title", "value"], "properties": { "type": { "const": "graph.updateDynamicPort" }, "graphId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "nodeId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "portId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "title": { "type": "string" }, "value": { "$ref": "visualbridge-primitives.schema.json#/$defs/jsonValue" } }, "additionalProperties": false },
    "graphRemoveDynamicPort": { "type": "object", "required": ["type", "graphId", "nodeId", "portId"], "properties": { "type": { "const": "graph.removeDynamicPort" }, "graphId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "nodeId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "portId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" } }, "additionalProperties": false },
    "graphReorderDynamicPorts": { "type": "object", "required": ["type", "graphId", "nodeId", "portIds"], "properties": { "type": { "const": "graph.reorderDynamicPorts" }, "graphId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "nodeId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "portIds": { "type": "array", "items": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" } } }, "additionalProperties": false },
    "graphAddEdge": { "type": "object", "required": ["type", "graphId", "edge"], "properties": { "type": { "const": "graph.addEdge" }, "graphId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "edge": { "$ref": "visualbridge-graph.schema.json#/$defs/edge" } }, "additionalProperties": false },
    "graphRemoveEdge": { "type": "object", "required": ["type", "graphId", "edgeId"], "properties": { "type": { "const": "graph.removeEdge" }, "graphId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "edgeId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" } }, "additionalProperties": false },
    "graphAssignType": { "type": "object", "required": ["type", "graphId", "graphTypeId"], "properties": { "type": { "const": "graph.assignType" }, "graphId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "graphTypeId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" } }, "additionalProperties": false },
    "graphUpdateGraph": { "type": "object", "required": ["type", "graphId", "title", "properties"], "properties": { "type": { "const": "graph.updateGraph" }, "graphId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "title": { "type": "string" }, "properties": { "$ref": "visualbridge-primitives.schema.json#/$defs/jsonObject" } }, "additionalProperties": false },
    "graphAddInterfacePort": { "type": "object", "required": ["type", "graphId", "port"], "properties": { "type": { "const": "graph.addInterfacePort" }, "graphId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "port": { "$ref": "visualbridge-graph.schema.json#/$defs/interfacePort" } }, "additionalProperties": false },
    "graphUpdateInterfacePort": { "type": "object", "required": ["type", "graphId", "portId", "title"], "properties": { "type": { "const": "graph.updateInterfacePort" }, "graphId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "portId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "title": { "type": "string" } }, "additionalProperties": false },
    "graphRemoveInterfacePort": { "type": "object", "required": ["type", "graphId", "portId"], "properties": { "type": { "const": "graph.removeInterfacePort" }, "graphId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "portId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" } }, "additionalProperties": false },
    "graphReorderInterfacePorts": { "type": "object", "required": ["type", "graphId", "portIds"], "properties": { "type": { "const": "graph.reorderInterfacePorts" }, "graphId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "portIds": { "type": "array", "items": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" } } }, "additionalProperties": false },
    "graphNodeIdOperation": { "type": "object", "required": ["type", "graphId", "nodeId"], "properties": { "type": { "const": "graph.removeNode" }, "graphId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "nodeId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" } }, "additionalProperties": false },

    "entityOperation": {
      "oneOf": [
        { "type": "object", "required": ["type", "title"], "properties": { "type": { "const": "entity.setTitle" }, "title": { "type": "string" } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "propertyId", "value"], "properties": { "type": { "const": "entity.setProperty" }, "propertyId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "value": { "$ref": "visualbridge-primitives.schema.json#/$defs/jsonValue" } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "componentId", "componentTypeId"], "properties": { "type": { "const": "entity.addComponent" }, "componentId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "componentTypeId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "index": { "type": "integer", "minimum": 0 } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "componentId", "newComponentId"], "properties": { "type": { "const": "entity.renameComponent" }, "componentId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "newComponentId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "componentId"], "properties": { "type": { "const": "entity.removeComponent" }, "componentId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "componentId", "index"], "properties": { "type": { "const": "entity.moveComponent" }, "componentId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "index": { "type": "integer", "minimum": 0 } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "componentId", "enabled"], "properties": { "type": { "const": "entity.setComponentEnabled" }, "componentId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "enabled": { "type": "boolean" } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "componentId", "propertyId", "value"], "properties": { "type": { "const": "entity.setComponentProperty" }, "componentId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "propertyId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "value": { "$ref": "visualbridge-primitives.schema.json#/$defs/jsonValue" } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "componentId", "newComponentId"], "properties": { "type": { "const": "entity.duplicateComponent" }, "componentId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "newComponentId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "index": { "type": "integer", "minimum": 0 } }, "additionalProperties": false }
      ]
    },
    "structuredOperation": { "type": "object", "required": ["type", "fieldId", "value"], "properties": { "type": { "const": "structured.setField" }, "fieldId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "value": { "$ref": "visualbridge-primitives.schema.json#/$defs/jsonValue" } }, "additionalProperties": false },
    "tableOperation": {
      "oneOf": [
        { "type": "object", "required": ["type", "sheetId", "rowId", "columnId", "value"], "properties": { "type": { "const": "table.setCell" }, "sheetId": { "type": "string", "minLength": 1 }, "rowId": { "type": "string", "minLength": 1 }, "columnId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "value": { "$ref": "visualbridge-primitives.schema.json#/$defs/jsonValue" } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "sheetId", "rowId"], "properties": { "type": { "const": "table.insertRow" }, "sheetId": { "type": "string", "minLength": 1 }, "rowId": { "type": "string", "minLength": 1 }, "index": { "type": "integer", "minimum": 0 }, "cells": { "$ref": "visualbridge-primitives.schema.json#/$defs/jsonObject" } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "sheetId", "rowId"], "properties": { "type": { "const": "table.removeRow" }, "sheetId": { "type": "string", "minLength": 1 }, "rowId": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "sheetId", "rowId", "index"], "properties": { "type": { "const": "table.moveRow" }, "sheetId": { "type": "string", "minLength": 1 }, "rowId": { "type": "string", "minLength": 1 }, "index": { "type": "integer", "minimum": 0 } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "sheetId", "rowId", "newRowId"], "properties": { "type": { "const": "table.duplicateRow" }, "sheetId": { "type": "string", "minLength": 1 }, "rowId": { "type": "string", "minLength": 1 }, "newRowId": { "type": "string", "minLength": 1 }, "index": { "type": "integer", "minimum": 0 } }, "additionalProperties": false }
      ]
    },
    "documentOperation": { "oneOf": [ { "$ref": "#/$defs/graphOperation" }, { "$ref": "#/$defs/entityOperation" }, { "$ref": "#/$defs/structuredOperation" }, { "$ref": "#/$defs/tableOperation" } ] },
    "documentTransport": {
      "type": "object", "required": ["projectId", "documentTypeId", "editor", "path", "baseHash", "document", "diagnostics"],
      "properties": { "projectId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "documentTypeId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "editor": { "enum": ["graph", "entity", "structured", "table"] }, "path": { "$ref": "visualbridge-primitives.schema.json#/$defs/normalizedPath" }, "baseHash": { "$ref": "visualbridge-primitives.schema.json#/$defs/sha256" }, "catalogHash": { "$ref": "visualbridge-primitives.schema.json#/$defs/sha256" }, "document": { "$ref": "visualbridge-primitives.schema.json#/$defs/jsonValue" }, "diagnostics": { "type": "array", "items": { "$ref": "visualbridge-primitives.schema.json#/$defs/diagnostic" } } }, "additionalProperties": false
    },
    "applyOperationsRequest": {
      "type": "object", "required": ["projectFile", "documentTypeId", "editor", "path", "baseHash", "operations"],
      "properties": { "projectFile": { "$ref": "visualbridge-primitives.schema.json#/$defs/normalizedPath" }, "documentTypeId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "editor": { "enum": ["graph", "entity", "structured", "table"] }, "path": { "$ref": "visualbridge-primitives.schema.json#/$defs/normalizedPath" }, "baseHash": { "$ref": "visualbridge-primitives.schema.json#/$defs/sha256" }, "operations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/documentOperation" } } }, "additionalProperties": false
    },
    "referenceDefinition": { "type": "object", "required": ["kind", "target", "allowMissing"], "properties": { "kind": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "target": { "$ref": "visualbridge-primitives.schema.json#/$defs/jsonObject" }, "allowMissing": { "type": "boolean" } }, "additionalProperties": false },
    "referenceLocation": { "type": "object", "required": ["projectId", "documentTypeId", "path"], "properties": { "projectId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "documentTypeId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "path": { "$ref": "visualbridge-primitives.schema.json#/$defs/normalizedPath" }, "documentId": { "type": "string", "minLength": 1 }, "componentId": { "type": "string", "minLength": 1 }, "elementKind": { "type": "string", "minLength": 1 }, "elementId": { "type": "string", "minLength": 1 }, "graphId": { "type": "string", "minLength": 1 }, "nodeId": { "type": "string", "minLength": 1 }, "portId": { "type": "string", "minLength": 1 }, "sheetId": { "type": "string", "minLength": 1 }, "rowId": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
    "referenceCandidate": { "type": "object", "required": ["kind", "target", "value", "title"], "properties": { "kind": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "target": { "$ref": "visualbridge-primitives.schema.json#/$defs/jsonObject" }, "value": { "$ref": "visualbridge-primitives.schema.json#/$defs/referenceValue" }, "title": { "type": "string" }, "description": { "type": "string" }, "location": { "$ref": "#/$defs/referenceLocation" } }, "additionalProperties": false },
    "referenceSearchCursor": { "type": "object", "required": ["version", "kind", "canonicalTarget", "query", "snapshotDependencyKey", "after"], "properties": { "version": { "const": 2 }, "kind": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "canonicalTarget": { "type": "string" }, "query": { "type": "string" }, "snapshotDependencyKey": { "type": "string" }, "after": { "type": "object", "required": ["title", "valueType", "value", "candidateKey"], "properties": { "title": { "type": "string" }, "valueType": { "enum": ["number", "string"] }, "value": { "$ref": "visualbridge-primitives.schema.json#/$defs/referenceValue" }, "candidateKey": { "type": "string" } }, "additionalProperties": false }, "providerContinuation": { "type": "object", "required": ["providerId", "instanceId", "generation", "entryHash", "cursor", "snapshotHash"], "properties": { "providerId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "instanceId": { "type": "string", "minLength": 1, "maxLength": 128 }, "generation": { "type": "integer", "minimum": 0 }, "entryHash": { "$ref": "visualbridge-primitives.schema.json#/$defs/sha256" }, "cursor": { "type": "string", "minLength": 1, "maxLength": 16384 }, "snapshotHash": { "$ref": "visualbridge-primitives.schema.json#/$defs/sha256" } }, "additionalProperties": false } }, "additionalProperties": false },
    "referenceSearchPage": { "oneOf": [ { "type": "object", "required": ["status", "candidates"], "properties": { "status": { "const": "ok" }, "candidates": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/referenceCandidate" } }, "nextCursor": { "$ref": "#/$defs/referenceSearchCursor" } }, "additionalProperties": false }, { "type": "object", "required": ["status", "candidates", "message"], "properties": { "status": { "enum": ["invalidTarget", "providerUnavailable", "cursor.invalid", "cursor.queryMismatch", "cursor.snapshotChanged"] }, "candidates": { "type": "array", "maxItems": 0 }, "message": { "type": "string", "minLength": 1 } }, "additionalProperties": false } ] },
    "refactorRequest": {
      "oneOf": [
        { "$ref": "#/$defs/refactorPreviewStringRequest" },
        { "$ref": "#/$defs/refactorPreviewNumberRequest" },
        { "$ref": "#/$defs/refactorApplyStringRequest" },
        { "$ref": "#/$defs/refactorApplyNumberRequest" }
      ]
    },
    "refactorPreviewStringRequest": { "$ref": "#/$defs/refactorPreviewRequest", "properties": { "oldValue": { "type": "string" }, "newValue": { "type": "string" } } },
    "refactorPreviewNumberRequest": { "$ref": "#/$defs/refactorPreviewRequest", "properties": { "oldValue": { "type": "number" }, "newValue": { "type": "number" } } },
    "refactorApplyStringRequest": { "$ref": "#/$defs/refactorApplyRequest", "properties": { "oldValue": { "type": "string" }, "newValue": { "type": "string" } } },
    "refactorApplyNumberRequest": { "$ref": "#/$defs/refactorApplyRequest", "properties": { "oldValue": { "type": "number" }, "newValue": { "type": "number" } } },
    "refactorPreviewRequest": { "type": "object", "required": ["projectFile", "action", "kind", "target", "oldValue", "newValue"], "properties": { "projectFile": { "$ref": "visualbridge-primitives.schema.json#/$defs/normalizedPath" }, "action": { "const": "preview" }, "kind": { "enum": ["document", "entity.component", "graph.element", "table.row"] }, "target": { "$ref": "visualbridge-primitives.schema.json#/$defs/jsonObject" }, "oldValue": { "$ref": "visualbridge-primitives.schema.json#/$defs/referenceValue" }, "newValue": { "$ref": "visualbridge-primitives.schema.json#/$defs/referenceValue" } }, "additionalProperties": false },
    "refactorApplyRequest": { "type": "object", "required": ["projectFile", "action", "kind", "target", "oldValue", "newValue", "previewHash", "baseHashes"], "properties": { "projectFile": { "$ref": "visualbridge-primitives.schema.json#/$defs/normalizedPath" }, "action": { "const": "apply" }, "kind": { "enum": ["document", "entity.component", "graph.element", "table.row"] }, "target": { "$ref": "visualbridge-primitives.schema.json#/$defs/jsonObject" }, "oldValue": { "$ref": "visualbridge-primitives.schema.json#/$defs/referenceValue" }, "newValue": { "$ref": "visualbridge-primitives.schema.json#/$defs/referenceValue" }, "previewHash": { "$ref": "visualbridge-primitives.schema.json#/$defs/sha256" }, "baseHashes": { "$ref": "visualbridge-primitives.schema.json#/$defs/hashManifest" } }, "additionalProperties": false },
    "lifecycleSelector": { "type": "object", "required": ["projectId", "documentTypeId", "editor", "path"], "properties": { "projectId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "documentTypeId": { "$ref": "visualbridge-primitives.schema.json#/$defs/stableId" }, "editor": { "enum": ["graph", "entity", "structured", "table"] }, "path": { "$ref": "visualbridge-primitives.schema.json#/$defs/normalizedPath" } }, "additionalProperties": false },
    "stableIdentityRemap": { "type": "object", "required": ["identityKey", "from", "to"], "properties": { "identityKey": { "type": "string", "minLength": 1, "maxLength": 1024 }, "from": { "$ref": "visualbridge-primitives.schema.json#/$defs/referenceValue" }, "to": { "$ref": "visualbridge-primitives.schema.json#/$defs/referenceValue" } }, "additionalProperties": false },
    "lifecycleOperation": { "oneOf": [ { "type": "object", "required": ["kind", "target", "parameters"], "properties": { "kind": { "const": "create" }, "target": { "$ref": "#/$defs/lifecycleSelector" }, "parameters": { "$ref": "visualbridge-primitives.schema.json#/$defs/jsonObject" } }, "additionalProperties": false }, { "type": "object", "required": ["kind", "source", "target", "stableIdRemap"], "properties": { "kind": { "const": "copy" }, "source": { "$ref": "#/$defs/lifecycleSelector" }, "target": { "$ref": "#/$defs/lifecycleSelector" }, "stableIdRemap": { "type": "array", "maxItems": 100000, "items": { "$ref": "#/$defs/stableIdentityRemap" } } }, "additionalProperties": false }, { "type": "object", "required": ["kind", "source", "target"], "properties": { "kind": { "const": "move" }, "source": { "$ref": "#/$defs/lifecycleSelector" }, "target": { "$ref": "#/$defs/lifecycleSelector" } }, "additionalProperties": false }, { "type": "object", "required": ["kind", "source", "target"], "properties": { "kind": { "const": "delete" }, "source": { "$ref": "#/$defs/lifecycleSelector" }, "target": { "$ref": "visualbridge-primitives.schema.json#/$defs/jsonObject" } }, "additionalProperties": false } ] },
    "lifecycleRequest": { "oneOf": [ { "type": "object", "required": ["action", "projectFile", "operation"], "properties": { "action": { "const": "preview" }, "projectFile": { "$ref": "visualbridge-primitives.schema.json#/$defs/normalizedPath" }, "operation": { "$ref": "#/$defs/lifecycleOperation" } }, "additionalProperties": false }, { "type": "object", "required": ["action", "projectFile", "operation", "previewHash", "planPayload", "baseHashes", "dependencies"], "properties": { "action": { "const": "apply" }, "projectFile": { "$ref": "visualbridge-primitives.schema.json#/$defs/normalizedPath" }, "operation": { "$ref": "#/$defs/lifecycleOperation" }, "previewHash": { "$ref": "visualbridge-primitives.schema.json#/$defs/sha256" }, "planPayload": { "type": "string", "minLength": 1, "maxLength": 16777216 }, "baseHashes": { "$ref": "visualbridge-primitives.schema.json#/$defs/hashManifest" }, "dependencies": { "type": "array", "maxItems": 100000, "items": { "$ref": "visualbridge-primitives.schema.json#/$defs/dependency" } } }, "additionalProperties": false } ] },
    "transactionPrecondition": { "oneOf": [ { "type": "object", "required": ["path", "hash"], "properties": { "path": { "$ref": "visualbridge-primitives.schema.json#/$defs/normalizedPath" }, "hash": { "$ref": "visualbridge-primitives.schema.json#/$defs/sha256" } }, "additionalProperties": false }, { "type": "object", "required": ["path", "expectedAbsent"], "properties": { "path": { "$ref": "visualbridge-primitives.schema.json#/$defs/normalizedPath" }, "expectedAbsent": { "const": true } }, "additionalProperties": false } ] },
    "transactionMutation": { "oneOf": [
      { "type": "object", "required": ["path", "beforeHash", "afterHash"], "properties": { "path": { "$ref": "visualbridge-primitives.schema.json#/$defs/normalizedPath" }, "beforeHash": { "$ref": "visualbridge-primitives.schema.json#/$defs/sha256" }, "afterHash": { "$ref": "visualbridge-primitives.schema.json#/$defs/sha256" } }, "additionalProperties": false },
      { "type": "object", "required": ["path", "afterHash"], "properties": { "path": { "$ref": "visualbridge-primitives.schema.json#/$defs/normalizedPath" }, "afterHash": { "$ref": "visualbridge-primitives.schema.json#/$defs/sha256" } }, "additionalProperties": false },
      { "type": "object", "required": ["path", "beforeHash"], "properties": { "path": { "$ref": "visualbridge-primitives.schema.json#/$defs/normalizedPath" }, "beforeHash": { "$ref": "visualbridge-primitives.schema.json#/$defs/sha256" } }, "additionalProperties": false }
    ] },
    "transactionResult": { "type": "object", "required": ["mutations"], "properties": { "mutations": { "type": "array", "items": { "$ref": "#/$defs/transactionMutation" } }, "maintenance": { "type": "object", "required": ["code", "message"], "properties": { "code": { "const": "transaction.finalizationPending" }, "message": { "type": "string", "minLength": 1 } }, "additionalProperties": false } }, "additionalProperties": false }
  }
}
