{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visualbridge.dev/schema/visualbridge-project.schema.json",
  "title": "VisualBridge Project File",
  "type": "object",
  "required": [
    "formatVersion",
    "projectId",
    "documentRoots",
    "modules",
    "documentTypes"
  ],
  "properties": {
    "formatVersion": {
      "const": 2
    },
    "projectId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "documentRoots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "description": "A forward-slash relative path inside the editable root. Use '.' for the root itself.",
        "pattern": "^(?:\\.|(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*//).+)$"
      }
    },
    "modules": {
      "type": "array",
      "description": "Authoring modules this Project declares. Empty is allowed; each entry is loaded from a single '.vbmodule.js' bundle.",
      "items": {
        "$ref": "#/$defs/module"
      }
    },
    "documentTypes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "editor",
          "include"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "editor": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "include": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "$ref": "#/$defs/safeGlob"
            }
          },
          "exclude": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "$ref": "#/$defs/safeGlob"
            },
            "default": []
          },
          "catalogs": {
            "type": "array",
            "uniqueItems": true,
            "description": "Project-relative Catalog paths consumed by this document type's editor category.",
            "items": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/provider"
      }
    }
  },
  "not": {
    "required": ["provider"]
  },
  "$defs": {
    "module": {
      "type": "object",
      "description": "A single Authoring module declared by the Project. The optional 'options' object belongs to that module.",
      "required": ["id", "entry"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "entry": {
          "type": "string",
          "description": "Normalized project-relative built module bundle using '/' separators; the suffix must be '.vbmodule.js'. Drive prefixes and control characters are rejected.",
          "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*[\\u0000-\\u001f\\u007f-\\u009f])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*//).+\\.vbmodule\\.js$"
        },
        "options": {
          "type": "object",
          "description": "Module-owned JSON object. Core only requires an object; the module's validateOptions validates the content."
        },
        "hash": {
          "type": "string",
          "description": "Optional lowercase-hex SHA-256 of the module bundle bytes. Declared values are compared at load time.",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "tableLayout": {
      "type": "object",
      "description": "Shape of the 'options.tableLayout' object declared by the 'visualbridge.table' module: 1-based rows for every CSV and XLSX table sheet.",
      "required": ["nameKeyRow", "dataStartRow"],
      "properties": {
        "nameKeyRow": {
          "type": "integer",
          "minimum": 1
        },
        "dataStartRow": {
          "type": "integer",
          "minimum": 2
        }
      },
      "additionalProperties": false
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "safeGlob": {
      "type": "string",
      "description": "Project-relative safe glob. Supports literal segments, one '*' per segment, and a whole '**' segment; excludes brace, extglob, character-class and '?' syntax.",
      "pattern": "^(?!/)(?![A-Za-z]:/)(?!!)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*//)(?!.*[?\\[\\]{}()!])(?!.*(?:^|/)(?!\\*\\*(?:/|$))[^/]*\\*[^/]*\\*)(?:[^/]+/)*[^/]+$"
    },
    "provider": {
      "type": "object",
      "required": ["id", "entry", "args", "capabilities"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "entry": {
          "type": "string",
          "description": "Normalized project-relative built ESM entry launched with the current Node executable.",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*//).+\\.mjs$"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "capabilities": {
          "$ref": "#/$defs/providerCapabilities"
        }
      },
      "additionalProperties": false
    },
    "providerCapabilities": {
      "type": "object",
      "properties": {
        "reference": {
          "type": "object",
          "required": ["kinds"],
          "properties": {
            "kinds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/identifier"
              }
            }
          },
          "additionalProperties": false
        },
        "validator": {
          "type": "object",
          "required": ["documentTypes"],
          "properties": {
            "documentTypes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/identifier"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "anyOf": [
        { "required": ["reference"] },
        { "required": ["validator"] }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
