{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visualbridge.dev/schema/visualbridge-project.schema.json",
  "title": "VisualBridge Project File",
  "type": "object",
  "required": [
    "formatVersion",
    "projectId",
    "documentRoots",
    "documentTypes"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "projectId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "documentRoots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "description": "A forward-slash relative path inside the editable root. Use '.' for the root itself."
      }
    },
    "documentTypes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "editor",
          "include"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "editor": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "include": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "exclude": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "default": []
          },
          "catalogs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "description": "Project-relative Catalog paths consumed by this document type's editor category.",
            "items": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "tableLayout": {
      "type": "object",
      "description": "Project-wide 1-based row layout used by every CSV and XLSX table sheet.",
      "required": [
        "nameKeyRow",
        "dataStartRow"
      ],
      "properties": {
        "nameKeyRow": {
          "type": "integer",
          "minimum": 1
        },
        "dataStartRow": {
          "type": "integer",
          "minimum": 2
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
