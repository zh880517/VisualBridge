{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visualbridge.dev/schema/visualbridge-editor-bridge.schema.json",
  "title": "VisualBridge Editor Bridge V2",
  "description": "Editor-mode leg of the unified VisualBridge connection protocol: the hello/welcome handshake (protocolVersion 4), editor open/reveal requests, the channel-0 debug-reporting control messages, and the per-window discovery record (formatVersion 2). This is the target unified handshake shape; per the 2026-10-27 review ruling, the Runtime leg adopts the same hello/welcome fields in E5. This schema only adds the editor-only messages.",
  "oneOf": [
    { "$ref": "#/$defs/helloMessage" },
    { "$ref": "#/$defs/welcomeMessage" },
    { "$ref": "#/$defs/openRequest" },
    { "$ref": "#/$defs/revealRequest" },
    { "$ref": "#/$defs/responseMessage" },
    { "$ref": "#/$defs/errorMessage" },
    { "$ref": "#/$defs/debugSetEnabledMessage" },
    { "$ref": "#/$defs/debugEnabledMessage" }
  ],
  "$defs": {
    "protocolVersion": {
      "const": 4
    },
    "role": {
      "description": "拨号方身份；监听方据此拒绝错配（方向层）。",
      "enum": ["editor", "vscode"]
    },
    "connectType": {
      "description": "监听方实际承载的连接拓扑。",
      "enum": ["editor", "editor-player", "player"]
    },
    "payload": {
      "description": "协商的载荷类型；json 必选。",
      "enum": ["json", "binary"]
    },
    "endpointId": {
      "description": "端点标识（不是调试实例 id）；VS Code 窗口与 Unity Editor 进程各自稳定。",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "bootId": {
      "description": "每次进程启动随机生成；Domain Reload 不改变。",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sessionId": {
      "description": "endpointId#bootId；跨 Domain Reload 稳定，generation 不参与。",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}#[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "contractHash": {
      "description": "调试契约指纹：16 位小写十六进制，无契约时为空串。",
      "type": "string",
      "pattern": "^([0-9a-f]{16})?$"
    },
    "payloadList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/payload" },
      "contains": { "const": "json" }
    },
    "debugFilter": {
      "description": "调试筛选：空数组/省略表示全部；服务端在入队前过滤。",
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    },
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "token": {
      "type": "string",
      "description": "Hex-encoded per-window authentication token of at least 192 bits.",
      "pattern": "^[0-9a-f]{48,64}$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "processId": {
      "type": "integer",
      "minimum": 1
    },
    "errorCode": {
      "enum": [
        "bridge.capabilityMissing",
        "bridge.documentAmbiguous",
        "bridge.documentUnresolved",
        "bridge.internalError",
        "bridge.invalidJson",
        "bridge.invalidMessage",
        "bridge.invalidToken",
        "bridge.protocolVersionMismatch",
        "bridge.unknownMessageType",
        "runtime.alreadyConnected",
        "runtime.contractHashMismatch",
        "runtime.invalidToken",
        "runtime.roleMismatch",
        "runtime.unsupportedPayload",
        "runtime.unsupportedProtocolVersion"
      ]
    },
    "helloMessage": {
      "type": "object",
      "description": "拨号方 → 监听方的首条消息；握手字段与 Runtime 腿共用同一形状（附录 A.3）。",
      "required": [
        "type",
        "protocolVersion",
        "role",
        "clientEndpointId",
        "contractHash",
        "payloads"
      ],
      "properties": {
        "type": { "const": "hello" },
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "role": { "$ref": "#/$defs/role" },
        "clientEndpointId": { "$ref": "#/$defs/endpointId" },
        "token": { "$ref": "#/$defs/token" },
        "contractHash": { "$ref": "#/$defs/contractHash" },
        "payloads": { "$ref": "#/$defs/payloadList" },
        "debugCategories": { "$ref": "#/$defs/debugFilter" },
        "debugInstances": { "$ref": "#/$defs/debugFilter" },
        "resumeSessionId": { "$ref": "#/$defs/sessionId" }
      },
      "additionalProperties": false
    },
    "welcomeMessage": {
      "type": "object",
      "description": "监听方 → 拨号方的握手应答；指明监听方端点、会话、连接拓扑与协商结果。",
      "required": [
        "type",
        "protocolVersion",
        "endpointId",
        "sessionId",
        "resumed",
        "connectType",
        "generation",
        "bootId",
        "contractHash",
        "payloads",
        "debugEnabled",
        "startedAt"
      ],
      "properties": {
        "type": { "const": "welcome" },
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "endpointId": { "$ref": "#/$defs/endpointId" },
        "sessionId": { "$ref": "#/$defs/sessionId" },
        "resumed": { "type": "boolean" },
        "connectType": { "$ref": "#/$defs/connectType" },
        "generation": { "$ref": "#/$defs/generation" },
        "bootId": { "$ref": "#/$defs/bootId" },
        "contractHash": { "$ref": "#/$defs/contractHash" },
        "payloads": { "$ref": "#/$defs/payloadList" },
        "debugEnabled": { "type": "boolean" },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "openRequest": {
      "type": "object",
      "description": "Requests the VS Code window to open an authoring document by project-root-relative path.",
      "required": [
        "type",
        "requestId",
        "documentPath"
      ],
      "properties": {
        "type": { "const": "open" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "documentPath": {
          "$ref": "visualbridge-primitives.schema.json#/$defs/normalizedPath"
        }
      },
      "additionalProperties": false
    },
    "revealRequest": {
      "type": "object",
      "description": "Requests the VS Code window to reveal a stable reference target; the window resolves the document and element via its reference service.",
      "required": [
        "type",
        "requestId",
        "reference"
      ],
      "properties": {
        "type": { "const": "reveal" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "reference": {
          "$ref": "visualbridge-primitives.schema.json#/$defs/referenceValue"
        }
      },
      "additionalProperties": false
    },
    "responseMessage": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "requestId",
            "status"
          ],
          "properties": {
            "type": { "const": "response" },
            "requestId": { "$ref": "#/$defs/requestId" },
            "status": { "const": "ok" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "requestId",
            "status",
            "error"
          ],
          "properties": {
            "type": { "const": "response" },
            "requestId": { "$ref": "#/$defs/requestId" },
            "status": { "const": "error" },
            "error": { "$ref": "#/$defs/errorCode" }
          },
          "additionalProperties": false
        }
      ]
    },
    "errorMessage": {
      "type": "object",
      "description": "Connection-level failure report sent before the peer closes the connection.",
      "required": [
        "type",
        "code"
      ],
      "properties": {
        "type": { "const": "error" },
        "code": { "$ref": "#/$defs/errorCode" },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "additionalProperties": false
    },
    "debugSetEnabledMessage": {
      "type": "object",
      "description": "调试上报开关请求（通道 0，宿主 → Unity）：监听方要求 Unity 打开或关闭调试流上报，Unity 以 debugEnabled 广播回报结果。enabled 必填且不可省略（缺字段按所需字段拒绝），类型不符按 bridge.invalidMessage 拒绝。",
      "required": [
        "type",
        "enabled"
      ],
      "properties": {
        "type": { "const": "debugSetEnabled" },
        "enabled": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "debugEnabledMessage": {
      "type": "object",
      "description": "调试上报开关状态广播（通道 0，Unity → 宿主）：Unity 采纳开关后回报当前值；面板以它作为唯一状态来源（不做本地乐观更新），Unity 每次连接时则以 welcome.debugEnabled 对齐。",
      "required": [
        "type",
        "enabled"
      ],
      "properties": {
        "type": { "const": "debugEnabled" },
        "enabled": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "absolutePath": {
      "type": "string",
      "description": "Absolute forward-slash path with an optional Windows drive prefix; no backslashes, dot segments, duplicate separators or trailing slash.",
      "pattern": "^(?:[A-Za-z]:)?/(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*/$)(?:[^/]+/)*[^/]+$"
    },
    "tcpPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "discoveryRecord": {
      "type": "object",
      "description": "Per-window discovery record published at <temp>/visualbridge-bridge/<windowId>.json; heartbeat is the file modification time. Staleness is heartbeat older than 5 seconds or a dead pid; records with formatVersion != 2 are ignored as if absent.",
      "required": [
        "formatVersion",
        "protocolVersion",
        "role",
        "tcpPort",
        "token",
        "pid",
        "generation",
        "windowId",
        "projectRoots"
      ],
      "properties": {
        "formatVersion": { "const": 2 },
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "role": { "$ref": "#/$defs/role" },
        "tcpPort": { "$ref": "#/$defs/tcpPort" },
        "token": { "$ref": "#/$defs/token" },
        "pid": { "$ref": "#/$defs/processId" },
        "generation": { "$ref": "#/$defs/generation" },
        "windowId": {
          "type": "string",
          "format": "uuid"
        },
        "projectRoots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/absolutePath" }
        }
      },
      "additionalProperties": false
    }
  }
}
