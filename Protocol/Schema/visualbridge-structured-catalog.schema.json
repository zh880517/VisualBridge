{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visualbridge.dev/schema/visualbridge-structured-catalog.schema.json",
  "title": "VisualBridge Structured Catalog V1",
  "type": "object",
  "required": [
    "formatVersion",
    "catalogId",
    "title",
    "source",
    "configTypes"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "catalogId": {
      "$ref": "#/$defs/identifier"
    },
    "title": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "source": {
      "$ref": "visualbridge-catalog-source.schema.json"
    },
    "configTypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/configType"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "nonEmptyString": {
      "type": "string",
      "pattern": "\\S"
    },
    "identifierArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "source": {
      "type": "object",
      "required": [
        "providerId",
        "typeName"
      ],
      "properties": {
        "providerId": {
          "$ref": "#/$defs/identifier"
        },
        "typeName": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "configType": {
      "type": "object",
      "required": [
        "id",
        "title",
        "aliases",
        "properties"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        }
      },
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "required": [
        "id",
        "title",
        "valueType",
        "defaultValue"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "aliases": {
          "$ref": "#/$defs/identifierArray",
          "default": []
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "valueType": {
          "$ref": "#/$defs/valueType"
        },
        "dataTypeId": {
          "$ref": "#/$defs/identifier"
        },
        "defaultValue": true,
        "editor": {
          "$ref": "#/$defs/editor"
        },
        "reference": {
          "$ref": "#/$defs/reference"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "item": {
          "$ref": "#/$defs/valueDefinition"
        }
      },
      "allOf": [
        { "$ref": "#/$defs/valueShape" }
      ],
      "additionalProperties": false
    },
    "valueDefinition": {
      "type": "object",
      "required": [
        "valueType",
        "defaultValue"
      ],
      "properties": {
        "valueType": {
          "$ref": "#/$defs/valueType"
        },
        "dataTypeId": {
          "$ref": "#/$defs/identifier"
        },
        "defaultValue": true,
        "editor": {
          "$ref": "#/$defs/editor"
        },
        "reference": {
          "$ref": "#/$defs/reference"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "item": {
          "$ref": "#/$defs/valueDefinition"
        }
      },
      "allOf": [
        { "$ref": "#/$defs/valueShape" }
      ],
      "additionalProperties": false
    },
    "valueType": {
      "enum": ["string", "number", "boolean", "object", "array", "json"]
    },
    "valueShape": {
      "type": "object",
      "if": {
        "type": "object",
        "properties": { "valueType": { "const": "object" } },
        "required": ["valueType"]
      },
      "then": {
        "type": "object",
        "required": ["fields"],
        "properties": { "fields": true, "item": false }
      },
      "else": {
        "if": {
          "type": "object",
          "properties": { "valueType": { "const": "array" } },
          "required": ["valueType"]
        },
        "then": {
          "type": "object",
          "required": ["item"],
          "properties": { "item": true, "fields": false }
        },
        "else": {
          "type": "object",
          "properties": { "fields": false, "item": false }
        }
      }
    },
    "reference": {
      "type": "object",
      "required": [
        "kind",
        "target"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/identifier"
        },
        "target": { "$ref": "visualbridge-primitives.schema.json#/$defs/jsonObject" },
        "allowMissing": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "editorOption": {
      "type": "object",
      "required": [
        "title",
        "value"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "value": true
      },
      "additionalProperties": false
    },
    "editor": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "text",
            "multiline",
            "number",
            "checkbox",
            "select",
            "color",
            "reference",
            "json"
          ]
        },
        "readOnly": {
          "type": "boolean",
          "default": false
        },
        "integer": {
          "type": "boolean",
          "default": false
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "step": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/editorOption"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "select" } },
            "required": ["kind"]
          },
          "then": {
            "required": ["options"],
            "properties": { "options": true }
          },
          "else": {
            "properties": { "options": false }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
