{
  "formatVersion": 1,
  "projectId": "visualbridge.unity-sample",
  "documentRoots": [
    "Config",
    "Entities"
  ],
  "documentTypes": [
    {
      "id": "sample.unity.game.settings",
      "editor": "structured",
      "include": [
        "Config/**/*.gamesettings"
      ],
      "exclude": [],
      "catalogs": [
        "Catalog/Gameplay.vbstructuredcatalog"
      ]
    },
    {
      "id": "sample.unity.hero",
      "editor": "entity",
      "include": [
        "Entities/**/*.vbentity"
      ],
      "exclude": [],
      "catalogs": [
        "Catalog/Gameplay.vbentitycatalog"
      ]
    }
  ]
}
