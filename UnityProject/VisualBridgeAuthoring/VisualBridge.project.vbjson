{
  "formatVersion": 2,
  "projectId": "visualbridge.unity-sample",
  "documentRoots": [
    "Config",
    "Entities",
    "Tables",
    "Graphs"
  ],
  "modules": [
    {
      "id": "visualbridge.structured",
      "entry": "Modules/structured.vbmodule.js"
    },
    {
      "id": "visualbridge.entity",
      "entry": "Modules/entity.vbmodule.js"
    },
    {
      "id": "visualbridge.table",
      "entry": "Modules/table.vbmodule.js",
      "options": {
        "tableLayout": {
          "nameKeyRow": 2,
          "dataStartRow": 3
        }
      }
    },
    {
      "id": "visualbridge.graph",
      "entry": "Modules/graph.vbmodule.js"
    }
  ],
  "documentTypes": [
    {
      "id": "sample.unity.game.settings",
      "editor": "structured",
      "include": [
        "Config/**/*.gamesettings"
      ],
      "exclude": [],
      "catalogs": [
        "Catalog/Gameplay.vbstructuredcatalog"
      ]
    },
    {
      "id": "sample.unity.hero",
      "editor": "entity",
      "include": [
        "Entities/**/*.vbentity"
      ],
      "exclude": [],
      "catalogs": [
        "Catalog/Gameplay.vbentitycatalog"
      ]
    },
    {
      "id": "sample.unity.skills",
      "editor": "table",
      "include": [
        "Tables/**/*.csv"
      ],
      "exclude": [],
      "catalogs": [
        "Catalog/Gameplay.vbtablecatalog"
      ]
    },
    {
      "id": "sample.unity.encounter",
      "editor": "graph",
      "include": [
        "Graphs/**/*.vbflow"
      ],
      "exclude": [],
      "catalogs": [
        "Catalog/Gameplay.vbgraphcatalog"
      ]
    }
  ]
}
