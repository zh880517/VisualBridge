{
  "formatVersion": 1,
  "projectId": "visualbridge.unity-sample",
  "documentRoots": [
    "Config",
    "Entities",
    "Tables"
  ],
  "documentTypes": [
    {
      "id": "sample.unity.game.settings",
      "editor": "structured",
      "include": [
        "Config/**/*.gamesettings"
      ],
      "exclude": [],
      "catalogs": [
        "Catalog/Gameplay.vbstructuredcatalog"
      ]
    },
    {
      "id": "sample.unity.hero",
      "editor": "entity",
      "include": [
        "Entities/**/*.vbentity"
      ],
      "exclude": [],
      "catalogs": [
        "Catalog/Gameplay.vbentitycatalog"
      ]
    },
    {
      "id": "sample.unity.skills",
      "editor": "table",
      "include": [
        "Tables/**/*.csv"
      ],
      "exclude": [],
      "catalogs": [
        "Catalog/Gameplay.vbtablecatalog"
      ]
    }
  ],
  "tableLayout": {
    "nameKeyRow": 2,
    "dataStartRow": 3
  }
}
