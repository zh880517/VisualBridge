{
  "formatVersion": 2,
  "projectId": "visualbridge.entity-semantics",
  "documentRoots": [
    "Config",
    "Tables"
  ],
  "modules": [
    {
      "id": "visualbridge.entity",
      "entry": "Modules/entity.vbmodule.js"
    },
    {
      "id": "visualbridge.table",
      "entry": "Modules/table.vbmodule.js",
      "options": {
        "tableLayout": {
          "nameKeyRow": 2,
          "dataStartRow": 3
        }
      }
    }
  ],
  "documentTypes": [
    {
      "id": "hero-config",
      "editor": "entity",
      "include": [
        "Config/Entities/**/*.herojson"
      ],
      "exclude": [],
      "catalogs": [
        "Catalog/Common.vbentitycatalog",
        "Catalog/Gameplay.vbentitycatalog"
      ]
    },
    {
      "id": "sample.table.skills",
      "editor": "table",
      "include": [
        "Tables/Skills_*.skillstable"
      ],
      "exclude": [],
      "catalogs": [
        "Catalog/Skills.vbtablecatalog"
      ]
    }
  ]
}
