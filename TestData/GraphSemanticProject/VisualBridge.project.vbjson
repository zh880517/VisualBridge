{
  "formatVersion": 1,
  "projectId": "GraphSemanticProject",
  "documentRoots": [
    "Graph",
    "Tables"
  ],
  "tableLayout": {
    "nameKeyRow": 2,
    "dataStartRow": 3
  },
  "documentTypes": [
    {
      "id": "logicGraph",
      "editor": "graph",
      "include": [
        "Graph/**/*.vbgraph"
      ],
      "exclude": [],
      "catalogs": [
        "Catalog/Common.vbgraphcatalog",
        "Catalog/Logic.vbgraphcatalog",
        "Catalog/Blocked.vbgraphcatalog"
      ]
    },
    {
      "id": "sample.table.skills",
      "editor": "table",
      "include": [
        "Tables/Skills_*.skillstable"
      ],
      "exclude": [],
      "catalogs": [
        "Catalog/Skills.vbtablecatalog"
      ]
    }
  ]
}
