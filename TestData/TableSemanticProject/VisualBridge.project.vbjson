{
  "formatVersion": 2,
  "projectId": "visualbridge.table-semantics",
  "documentRoots": [
    "Tables"
  ],
  "modules": [
    {
      "id": "visualbridge.table",
      "entry": "Modules/table.vbmodule.js",
      "options": {
        "tableLayout": {
          "nameKeyRow": 2,
          "dataStartRow": 3
        }
      }
    }
  ],
  "documentTypes": [
    {
      "id": "game.table.skills",
      "editor": "table",
      "include": [
        "Tables/Skills_*.csv",
        "Tables/Skills.xlsx"
      ],
      "exclude": [],
      "catalogs": [
        "Catalog/Gameplay.vbtablecatalog"
      ]
    }
  ]
}
