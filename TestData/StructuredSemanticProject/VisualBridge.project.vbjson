{
  "formatVersion": 2,
  "projectId": "visualbridge.structured-semantics",
  "documentRoots": [
    "Config",
    "Tables"
  ],
  "modules": [
    {
      "id": "visualbridge.structured",
      "entry": "Modules/structured.vbmodule.js"
    },
    {
      "id": "visualbridge.table",
      "entry": "Modules/table.vbmodule.js",
      "options": {
        "tableLayout": {
          "nameKeyRow": 2,
          "dataStartRow": 3
        }
      }
    }
  ],
  "documentTypes": [
    {
      "id": "sample.game.settings",
      "editor": "structured",
      "include": [
        "Config/**/*.gamesettings"
      ],
      "exclude": [
        "Config/Excluded/**"
      ],
      "catalogs": [
        "Catalog/Game.vbstructuredcatalog"
      ]
    },
    {
      "id": "sample.table.skills",
      "editor": "table",
      "include": [
        "Tables/Skills_*.skillstable"
      ],
      "exclude": [],
      "catalogs": [
        "Catalog/Skills.vbtablecatalog"
      ]
    }
  ]
}
