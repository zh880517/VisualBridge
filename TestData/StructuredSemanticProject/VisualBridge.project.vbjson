{
  "formatVersion": 1,
  "projectId": "visualbridge.structured-semantics",
  "documentRoots": [
    "Config",
    "Tables"
  ],
  "documentTypes": [
    {
      "id": "sample.game.settings",
      "editor": "structured",
      "include": [
        "Config/**/*.gamesettings"
      ],
      "exclude": [],
      "catalogs": [
        "Catalog/Game.vbstructuredcatalog"
      ]
    },
    {
      "id": "sample.table.skills",
      "editor": "table",
      "include": [
        "Tables/Skills_*.skillstable"
      ],
      "exclude": [],
      "catalogs": [
        "Catalog/Skills.vbtablecatalog"
      ]
    }
  ],
  "tableLayout": {
    "nameKeyRow": 2,
    "dataStartRow": 3
  }
}
