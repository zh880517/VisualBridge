{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "jsx": "react-jsx",
    "module": "Node16",
    "moduleResolution": "Node16",
    "noEmit": false,
    "outDir": ".test-dist",
    "rootDir": ".",
    "sourceMap": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/tableReveal.ts",
    "src/tableRecordVirtualization.ts",
    "src/virtualizedTableRecordViewport.tsx",
    "test/**/*.ts",
    "test/**/*.tsx"
  ]
}
